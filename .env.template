# Copy this file to .env and fill in the values.
# .env is gitignored and must never be committed.

# ── Required ────────────────────────────────────────────────────
# The app refuses to start if any of these is missing.

# Groq API key — https://console.groq.com/keys
GROQ_API_KEY=

# Bearer token protecting the API. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=

# Groq model used by every agent and LLM call.
# Check https://console.groq.com/docs/deprecations for current models.
GROQ_MODEL=openai/gpt-oss-120b

# ── Optional ────────────────────────────────────────────────────

# How /brand, /generate and /feedback execute.
#   1 = ReAct agents with tool-calling and agent_trace (~3-6 Groq calls)
#   0 = one direct LLM call per request (faster, lighter on rate limits)
AGENT_MODE=1

# SQLAlchemy connection string.
DATABASE_URL=sqlite:///./personaai.db

# SQLite file read by the Streamlit dashboard.
PERSONAAI_DB_PATH=personaai.db

# Comma-separated origins allowed to call the API from a browser.
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# /metrics requires the API key by default. Set to 1 only when the endpoint
# is reachable solely from a private network, such as a Prometheus sidecar.
METRICS_PUBLIC=0

# ── Operator (only you) ─────────────────────────────────────────

# A second key for operator routes: /costs and /audit-logs, which show token
# usage and spend. Keep it different from API_KEY and never put it in the UI.
# Leave empty to disable those routes. Generate one the same way as API_KEY.
ADMIN_API_KEY=

# Prices in US dollars per million tokens, used to compute cost per call.
# Defaults match Groq's rates for openai/gpt-oss-120b. Update them if you
# change GROQ_MODEL: https://groq.com/pricing
LLM_INPUT_PRICE_PER_MILLION=0.15
LLM_OUTPUT_PRICE_PER_MILLION=0.60

# Daily spend limit in USD, midnight to midnight UTC. Leave empty for no limit.
# At BUDGET_SOFT_LIMIT_PERCENT of it, agents pause and requests use one direct
# call. At 100%, routes that call the model return 429 until midnight UTC.
# Users only see "daily AI usage limit reached", never the amounts.
DAILY_BUDGET_USD=
BUDGET_SOFT_LIMIT_PERCENT=80

# Output token cap per structured LLM call. gpt-oss's hidden reasoning counts
# against it too; 2048 was too low for the longer content prompts. On Groq's
# free tier, prompt + this cap must fit in 8K tokens per minute.
LLM_MAX_TOKENS=4096

# gpt-oss reasoning effort: low, medium or high. Empty uses Groq's default.
# Lower is cheaper and faster; measure quality with evals/run_eval first.
LLM_REASONING_EFFORT=
