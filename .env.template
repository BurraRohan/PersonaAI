# Copy this file to .env and fill in the values.
# .env is gitignored and must never be committed.

# Groq API key — https://console.groq.com/keys
GROQ_API_KEY=

# Bearer token protecting the API. Required; the app will not start without it.
# Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=

# How /brand, /generate and /feedback execute.
#   1 = run the ReAct agents (tool-calling + agent_trace). ~3-6 Groq calls per request.
#   0 = one direct LLM call per request. Faster, far lighter on the rate limit.
# Use 0 while building and testing, 1 for the demo. Default is 1.
AGENT_MODE=1

# Groq model used by all agents and LLM calls. Required; the app will not
# start without it. llama-3.3-70b-versatile was deprecated on 17 June 2026.
# Check https://console.groq.com/docs/deprecations for current models.
GROQ_MODEL=openai/gpt-oss-120b

# Optional. Defaults to a local SQLite file.
DATABASE_URL=sqlite:///./personaai.db

# Optional. Comma-separated origins allowed to call the API from a browser.
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000